<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="890dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="330dp"
                    android:layout_gravity="top"
                    android:background="@color/black" />

                <ProgressBar
                    android:id="@+id/profileProgressBar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="32dp"
                    android:layout_marginEnd="28dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_gravity="top"
                    android:layout_marginStart="54dp"
                    android:layout_marginTop="86dp"
                    android:layout_marginEnd="42dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_avatar_profile" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="28dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hello"
                            android:textColor="@color/white"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/profileNameText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Customer"
                            android:textColor="@color/white"
                            android:textSize="33sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/profilePointsText"
                            android:layout_width="210dp"
                            android:layout_height="54dp"
                            android:layout_marginTop="18dp"
                            android:background="@drawable/bg_profile_points_pill"
                            android:gravity="center"
                            android:text="0.00 Points"
                            android:textColor="@color/black"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/myAccountCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="22dp"
                    android:layout_marginEnd="22dp"
                    android:background="@drawable/bg_profile_section_card"
                    android:clipToOutline="true"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="82dp"
                        android:background="@drawable/bg_profile_section_header"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="26dp"
                        android:paddingEnd="26dp">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:contentDescription="@string/app_name"
                            android:src="@drawable/ic_person_simple"
                            android:tint="@color/nav_icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="18dp"
                            android:text="My Account"
                            android:textColor="@color/text_primary"
                            android:textSize="24sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/profileMyProfileRow"
                        style="@style/ProfileMenuRow">
                        <TextView
                            style="@style/ProfileMenuTitle"
                            android:text="My Profile" />
                        <TextView
                            style="@style/ProfileMenuSubtitle"
                            android:text="View &amp; update your profile information" />
                    </LinearLayout>

                    <View style="@style/ProfileMenuDivider" />

                    <LinearLayout
                        android:id="@+id/profileDarkModeRow"
                        style="@style/ProfileMenuRow"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/ProfileMenuTitle"
                                android:text="Dark Mode" />

                            <TextView
                                style="@style/ProfileMenuSubtitle"
                                android:text="Use a darker theme across the app" />
                        </LinearLayout>

                        <Switch
                            android:id="@+id/darkModeSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/primary" />
                    </LinearLayout>

                    <View style="@style/ProfileMenuDivider" />

                    <LinearLayout
                        android:id="@+id/profileAddressRow"
                        style="@style/ProfileMenuRow">
                        <TextView
                            style="@style/ProfileMenuTitle"
                            android:text="My Address" />
                        <TextView
                            style="@style/ProfileMenuSubtitle"
                            android:text="View &amp; update your address" />
                    </LinearLayout>

                    <View style="@style/ProfileMenuDivider" />

                    <LinearLayout
                        android:id="@+id/profileOrdersRow"
                        style="@style/ProfileMenuRow">
                        <TextView
                            style="@style/ProfileMenuTitle"
                            android:text="Orders" />
                        <TextView
                            style="@style/ProfileMenuSubtitle"
                            android:text="View your recent orders history &amp; details" />
                    </LinearLayout>

                    <View style="@style/ProfileMenuDivider" />

                    <LinearLayout
                        android:id="@+id/profileReturnsRow"
                        style="@style/ProfileMenuRow">
                        <TextView
                            style="@style/ProfileMenuTitle"
                            android:text="My Returns" />
                        <TextView
                            style="@style/ProfileMenuSubtitle"
                            android:text="View your return request history &amp; status" />
                    </LinearLayout>

                    <View style="@style/ProfileMenuDivider" />

                    <LinearLayout
                        android:id="@+id/profileWishlistRow"
                        style="@style/ProfileMenuRow">
                        <TextView
                            style="@style/ProfileMenuTitle"
                            android:text="Wishlist" />
                        <TextView
                            style="@style/ProfileMenuSubtitle"
                            android:text="View products from your wishlist" />
                    </LinearLayout>

                    <View style="@style/ProfileMenuDivider" />

                    <LinearLayout
                        android:id="@+id/profileNotificationsRow"
                        style="@style/ProfileMenuRow">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/ProfileMenuTitle"
                                android:layout_width="wrap_content"
                                android:text="Notifications" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="( 26 )"
                                android:textColor="#D80000"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            style="@style/ProfileMenuSubtitle"
                            android:text="View latest offers and news updates from StyleOra" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="22dp"
                android:layout_marginTop="26dp"
                android:layout_marginEnd="22dp"
                android:background="@drawable/bg_profile_section_card"
                android:clipToOutline="true"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="82dp"
                    android:background="@drawable/bg_profile_section_header"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="26dp"
                    android:paddingEnd="26dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_tag_policy"
                        android:tint="@color/nav_icon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:text="Terms &amp; Policy"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/termsConditionsRow"
                    style="@style/ProfileMenuRow">
                    <TextView
                        style="@style/ProfileMenuTitle"
                        android:text="Terms &amp; Conditions" />
                    <TextView
                        style="@style/ProfileMenuSubtitle"
                        android:text="Read StyleOra's terms &amp; conditions" />
                </LinearLayout>

                <View style="@style/ProfileMenuDivider" />

                <LinearLayout
                    android:id="@+id/returnPolicyRow"
                    style="@style/ProfileMenuRow">
                    <TextView
                        style="@style/ProfileMenuTitle"
                        android:text="Return &amp; Refund Policy" />
                    <TextView
                        style="@style/ProfileMenuSubtitle"
                        android:text="Read our return &amp; refund policy" />
                </LinearLayout>

                <View style="@style/ProfileMenuDivider" />

                <LinearLayout
                    android:id="@+id/privacyPolicyRow"
                    style="@style/ProfileMenuRow">
                    <TextView
                        style="@style/ProfileMenuTitle"
                        android:text="Privacy Policy" />
                    <TextView
                        style="@style/ProfileMenuSubtitle"
                        android:text="Read our privacy policy" />
                </LinearLayout>

                <View style="@style/ProfileMenuDivider" />

                <LinearLayout
                    android:id="@+id/shippingDeliveryRow"
                    style="@style/ProfileMenuRow">
                    <TextView
                        style="@style/ProfileMenuTitle"
                        android:text="Shipping &amp; Delivery" />
                    <TextView
                        style="@style/ProfileMenuSubtitle"
                        android:text="Learn how our shipping &amp; delivery process works." />
                </LinearLayout>

                <View style="@style/ProfileMenuDivider" />

                <LinearLayout
                    android:id="@+id/dataDeletionRow"
                    style="@style/ProfileMenuRow">
                    <TextView
                        style="@style/ProfileMenuTitle"
                        android:text="Data Deletion" />
                    <TextView
                        style="@style/ProfileMenuSubtitle"
                        android:text="Delete your StyleOra profile &amp; data" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/logoutRow"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginStart="22dp"
                android:layout_marginTop="34dp"
                android:layout_marginEnd="22dp"
                android:background="@drawable/bg_profile_section_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="34dp"
                android:paddingEnd="34dp">

                <TextView
                    style="@style/ProfileMenuTitle"
                    android:text="Logout" />

                <TextView
                    style="@style/ProfileMenuSubtitle"
                    android:text="Logout from StyleOra app" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:background="@color/surface"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:weightSum="4">

        <LinearLayout
            android:id="@+id/navHome"
            style="@style/ProfileBottomNavItem">
            <ImageView
                style="@style/ProfileBottomNavIcon"
                android:src="@drawable/ic_home_nav" />
            <TextView
                style="@style/ProfileBottomNavText"
                android:text="Home" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navBrands"
            style="@style/ProfileBottomNavItem">
            <ImageView
                style="@style/ProfileBottomNavIcon"
                android:src="@drawable/ic_diamond_nav" />
            <TextView
                style="@style/ProfileBottomNavText"
                android:text="Brands" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCategories"
            style="@style/ProfileBottomNavItem">
            <ImageView
                style="@style/ProfileBottomNavIcon"
                android:src="@drawable/ic_categories_nav" />
            <TextView
                style="@style/ProfileBottomNavText"
                android:text="Categories" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navBlog"
            style="@style/ProfileBottomNavItem">
            <ImageView
                style="@style/ProfileBottomNavIcon"
                android:src="@drawable/ic_book_nav" />
            <TextView
                style="@style/ProfileBottomNavText"
                android:text="Blog" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
