<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:background="@drawable/bg_home_top"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/homeMenuButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="StyleOra"
                android:textColor="@color/primary"
                android:textSize="26sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/homeSearchButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_home_icon_button"
                android:clickable="true"
                android:contentDescription="Search"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_search_simple" />

            <FrameLayout
                android:id="@+id/homeCartButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_home_icon_button"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Bag"
                    android:padding="10dp"
                    android:src="@drawable/ic_bag_simple" />

                <TextView
                    android:id="@+id/homeCartBadgeText"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_notification_badge"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/homeNotificationButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_home_icon_button"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Notifications"
                    android:padding="10dp"
                    android:src="@drawable/ic_bell_simple" />

                <TextView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_notification_badge"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <ImageView
                android:id="@+id/homeProfileButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_home_icon_button"
                android:clickable="true"
                android:contentDescription="Profile"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_user_simple" />
        </LinearLayout>

        <EditText
            android:id="@+id/homeSearchInput"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_home_search_pill"
            android:drawableStart="@drawable/ic_search_simple"
            android:drawablePadding="8dp"
            android:hint="Search lipstick, kurti, serum, bag..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/homeRootScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/homeBannerPager"
                android:layout_width="match_parent"
                android:layout_height="232dp" />

            <LinearLayout
                android:id="@+id/homeDotsContainer"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/homeWishlistShortcut"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_category_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Wishlist"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/homeOrdersShortcut"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_category_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="My Orders"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                style="@style/HomeSectionHeader"
                android:layout_marginTop="22dp">

                <TextView
                    style="@style/HomeSectionTitle"
                    android:text="Hot Deals" />

                <TextView
                    android:id="@+id/homeViewAllHotDeals"
                    style="@style/HomeViewAll"
                    android:text="View all" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/homeHotDealsSkeleton"
                android:layout_width="match_parent"
                android:layout_height="264dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="176dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="176dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_skeleton" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/homeHotDealsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="284dp"
                android:layout_marginTop="6dp"
                android:clipToPadding="false"
                android:paddingEnd="8dp"
                android:visibility="gone" />

            <TextView
                style="@style/HomeSectionTitle"
                android:layout_width="match_parent"
                android:layout_marginTop="22dp"
                android:layout_weight="0"
                android:text="Shop By Category" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/homeCategoriesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="128dp"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:paddingEnd="8dp" />

            <LinearLayout
                style="@style/HomeSectionHeader"
                android:layout_marginTop="22dp">

                <TextView
                    style="@style/HomeSectionTitle"
                    android:text="Featured Products" />

                <TextView
                    android:id="@+id/homeViewAllProducts"
                    style="@style/HomeViewAll"
                    android:text="View all" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/homeFeaturedSkeleton"
                android:layout_width="match_parent"
                android:layout_height="270dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_skeleton" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/homeFeaturedRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <TextView
                style="@style/HomeSectionTitle"
                android:layout_width="match_parent"
                android:layout_marginTop="22dp"
                android:layout_weight="0"
                android:text="Recommended Products" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/homeRecommendedRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="284dp"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:paddingEnd="8dp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:background="@drawable/bg_home_bottom_nav"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/navHome"
            style="@style/HomeBottomNavItem"
            android:background="@drawable/bg_home_nav_selected">
            <ImageView
                style="@style/HomeBottomNavIcon"
                android:src="@drawable/ic_home_nav" />
            <TextView
                style="@style/HomeBottomNavText"
                android:text="Home"
                android:textColor="@color/primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navBrands"
            style="@style/HomeBottomNavItem">
            <ImageView
                style="@style/HomeBottomNavIcon"
                android:src="@drawable/ic_diamond_nav" />
            <TextView
                style="@style/HomeBottomNavText"
                android:text="Brands" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCategories"
            style="@style/HomeBottomNavItem">
            <ImageView
                style="@style/HomeBottomNavIcon"
                android:src="@drawable/ic_categories_nav" />
            <TextView
                style="@style/HomeBottomNavText"
                android:text="Categories" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navBlog"
            style="@style/HomeBottomNavItem">
            <ImageView
                style="@style/HomeBottomNavIcon"
                android:src="@drawable/ic_book_nav" />
            <TextView
                style="@style/HomeBottomNavText"
                android:text="Blog" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
